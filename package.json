{
  "name": "arcadia-editions-slides",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build-all.mjs",
    "dev:theme-showcase": "slidev talks/theme-showcase/slides.md",
    "build:theme-showcase": "node clean-out.mjs theme-showcase && slidev build talks/theme-showcase/slides.md --out ../../output/theme-showcase",
    "export:theme-showcase": "slidev export talks/theme-showcase/slides.md --output output/theme-showcase.pdf",
    "browsers": "playwright install chromium",
    "dev:2026-11-19-coruna-jug": "slidev talks/2026-11-19-coruna-jug/slides.md",
    "build:2026-11-19-coruna-jug": "node clean-out.mjs 2026-11-19-coruna-jug && slidev build talks/2026-11-19-coruna-jug/slides.md --out ../../output/2026-11-19-coruna-jug",
    "export:2026-11-19-coruna-jug": "slidev export talks/2026-11-19-coruna-jug/slides.md --output output/2026-11-19-coruna-jug.pdf"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.8",
    "@slidev/cli": "53.0.0"
  },
  "devDependencies": {
    "playwright-chromium": "1.64.0"
  }
}
